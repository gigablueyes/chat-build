ENVIRONMENT=dev
DEBUG=true
SECRET_KEY=change-this-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (use PostgreSQL in staging/prod)
DATABASE_URL=sqlite:///./chatbuild.db
# Example PostgreSQL URL:
# DATABASE_URL=postgresql://<db_user>:<db_password>@localhost:5432/chatbuild

# CORS - comma separated list is parsed by pydantic-settings as JSON or repeated env vars
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# LLM provider: "mock" (default, no external calls) or "openai"
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Deployment
GITHUB_PAGES_BASE_URL=
CLOUD_PROVIDER=none
